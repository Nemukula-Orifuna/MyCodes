{
  "name": "pharma-caliper-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperledger Caliper workloads benchmarking PharmaSupplyChain.sol against local Ganache",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "bind": "caliper bind --caliper-bind-sut ethereum:latest",
    "test": "caliper launch manager --caliper-workspace . --caliper-networkconfig networks/ganache.json --caliper-benchconfig benchmarks.yaml --caliper-flow-only-test"
  },
  "devDependencies": {
    "@hyperledger/caliper-cli": "0.6.0"
  },
  "dependencies": {
    "web3": "^1.3.0"
  }
}
