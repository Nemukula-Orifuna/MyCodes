{
  "name": "pharmatrace",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-based authentication for preventing counterfeit pharmaceuticals (Truffle + Ganache + React + Web3.js)",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "chain": "ganache --wallet.deterministic --wallet.totalAccounts 10 --chain.chainId 1337 --chain.networkId 1337 --server.port 8545 --database.dbPath .ganache-db",
    "chain:fresh": "rimraf .ganache-db && npm run chain",
    "chain:interval": "ganache --wallet.deterministic --chain.chainId 1337 --chain.networkId 1337 --server.port 8545 --miner.blockTime 2",
    "compile": "truffle compile",
    "migrate": "truffle migrate --reset",
    "test": "truffle test",
    "test:gas": "cross-env GAS_REPORT=1 truffle test"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "eth-gas-reporter": "0.2.27",
    "ganache": "7.9.2",
    "rimraf": "5.0.10",
    "truffle": "5.11.5",
    "web3": "4.16.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6"
  }
}
